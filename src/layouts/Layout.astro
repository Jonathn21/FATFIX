---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "FastFix — Réparation smartphone, tablette & ordinateur",
  description = "Réparation express de smartphones, tablettes et ordinateurs. Pièces d'origine, garantie incluse, prêt en 60 minutes.",
} = Astro.props;
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>

    <!-- Les animations d'apparition ne masquent le contenu que si le JavaScript
         répond. Sans ce marqueur (JS bloqué ou en erreur), tout reste visible. -->
    <script is:inline>
      document.documentElement.classList.add("ff-anim");
    </script>
  </head>
  <body class="min-h-screen">
    <slot />

    <!-- WhatsApp floating button -->
    <a href="https://wa.me/3222194916" data-ff-wa="contact.whatsapp" target="_blank" rel="noopener noreferrer" class="whatsapp-float" aria-label="Contactez-nous sur WhatsApp">
      <svg class="h-7 w-7 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
    </a>

    <!-- Scroll to top button -->
    <button id="scrollTopBtn" class="scroll-top" aria-label="Retour en haut">
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 15.75l7.5-7.5 7.5 7.5"/></svg>
    </button>

    <!-- Réglages du site (WordPress) : remplit les éléments marqués data-ff-* -->
    <script>
      const FASTFIX_API_URL = "https://ahmedc12.sg-host.com/wp-json/fastfix/v1";

      // Lit une valeur imbriquée : get(cfg, "contact.phone")
      const readPath = (obj: any, path: string) =>
        path.split(".").reduce((acc: any, key: string) => (acc == null ? acc : acc[key]), obj);

      const applyConfig = (cfg: any) => {
        // Texte
        document.querySelectorAll<HTMLElement>("[data-ff]").forEach((el) => {
          const value = readPath(cfg, el.dataset.ff!);
          if (value) el.textContent = String(value);
        });

        // Liens, avec le préfixe correspondant au type
        const linkTypes: Record<string, string> = {
          ffHref: "",
          ffTel: "tel:",
          ffMailto: "mailto:",
          ffWa: "https://wa.me/",
        };
        Object.entries(linkTypes).forEach(([key, prefix]) => {
          const attr = "data-" + key.replace(/[A-Z]/g, (c) => "-" + c.toLowerCase());
          document.querySelectorAll<HTMLAnchorElement>(`[${attr}]`).forEach((el) => {
            const value = readPath(cfg, el.dataset[key]!);
            if (value) el.href = prefix + value;
            else if (prefix === "https://wa.me/") el.remove(); // pas de WhatsApp configuré
          });
        });

        // Réseaux sociaux : masque les liens non renseignés
        document.querySelectorAll<HTMLElement>("[data-ff-social]").forEach((el) => {
          const url = cfg.socials?.[el.dataset.ffSocial!];
          if (url) (el as HTMLAnchorElement).href = url;
          else el.remove();
        });

        // Pastille d'ouverture : verte quand la boutique est ouverte
        document.querySelectorAll<HTMLElement>("[data-ff-status-dot]").forEach((el) => {
          el.classList.remove("bg-red-400", "bg-green-400");
          el.classList.add(cfg.hours?.isOpen ? "bg-green-400" : "bg-red-400");
        });

        // Contenus des pages : titres, textes et images de chaque section.
        // Une clé vide côté WordPress laisse le contenu d'origine en place.
        const content = cfg.content || {};

        document.querySelectorAll<HTMLElement>("[data-ff-content]").forEach((el) => {
          const value = content[el.dataset.ffContent!];
          if (!value) return;
          // Les retours à la ligne sont conservés visuellement
          if (String(value).includes("\n")) {
            el.innerHTML = String(value)
              .split("\n")
              .map((line) => line.replace(/[<>&]/g, (c) => ({ "<": "&lt;", ">": "&gt;", "&": "&amp;" })[c]!))
              .join("<br>");
          } else {
            el.textContent = String(value);
          }
        });

        document.querySelectorAll<HTMLImageElement>("[data-ff-img]").forEach((el) => {
          const value = content[el.dataset.ffImg!];
          if (value) el.src = String(value);
        });
      };

      fetch(`${FASTFIX_API_URL}/config`)
        .then((res) => (res.ok ? res.json() : Promise.reject(res)))
        .then(applyConfig)
        .catch(() => {
          /* API injoignable : le HTML garde ses valeurs par défaut */
        });
    </script>

    <!-- Scroll reveal observer + scroll to top -->
    <script>
      // Reveal on scroll
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("visible");
            }
          });
        },
        { threshold: 0.08, rootMargin: "0px 0px -20px 0px" }
      );

      document
        .querySelectorAll("[data-reveal], [data-reveal-children]")
        .forEach((el) => observer.observe(el));

      // Scroll to top button
      const scrollBtn = document.getElementById("scrollTopBtn");
      if (scrollBtn) {
        window.addEventListener("scroll", () => {
          if (window.scrollY > 600) {
            scrollBtn.classList.add("visible");
          } else {
            scrollBtn.classList.remove("visible");
          }
        }, { passive: true });

        scrollBtn.addEventListener("click", () => {
          window.scrollTo({ top: 0, behavior: "smooth" });
        });
      }
    </script>
  </body>
</html>
