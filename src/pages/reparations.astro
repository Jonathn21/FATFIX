---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

const categories = [
  {
    name: "iPhone",
    img: "/images/devices/iphone-16.webp",
    devices: [
      { name: "iPhone 17 Pro Max", img: "/images/devices/iphone-17-pro-max.webp" },
      { name: "iPhone 17 Pro", img: "/images/devices/iphone-17-pro.webp" },
      { name: "iPhone 17", img: "/images/devices/iphone-17.webp" },
      { name: "iPhone 16 Pro Max", img: "/images/devices/iphone-16-pro-max.webp" },
      { name: "iPhone 16", img: "/images/devices/iphone-16.webp" },
    ],
  },
  {
    name: "Samsung Galaxy",
    img: "/images/devices/galaxy-s26-ultra.webp",
    devices: [
      { name: "Galaxy S26 Ultra", img: "/images/devices/galaxy-s26-ultra.webp" },
      { name: "Galaxy S26+", img: "/images/devices/galaxy-s26-plus.webp" },
      { name: "Galaxy S26", img: "/images/devices/galaxy-s26.webp" },
      { name: "Galaxy S24", img: "/images/devices/galaxy-s24.webp" },
      { name: "Galaxy S23 Ultra", img: "/images/devices/galaxy-s23-ultra.webp" },
    ],
  },
  {
    name: "iPad",
    img: "/images/devices/ipad-pro.webp",
    devices: [
      { name: "iPad Pro 13\" M5", img: "/images/devices/ipad-pro-m5.webp" },
      { name: "iPad Pro 13\" M4", img: "/images/devices/ipad-pro.webp" },
    ],
  },
  {
    name: "MacBook & iMac",
    img: "/images/devices/macbook-air.webp",
    devices: [
      { name: "MacBook Air M4", img: "/images/devices/macbook-air.webp" },
      { name: "iMac 24\" M4", img: "/images/devices/imac.webp" },
    ],
  },
  {
    name: "Consoles & Autres",
    img: "/images/devices/ps5.webp",
    devices: [
      { name: "Apple Watch", img: "/images/devices/apple-watch.webp" },
      { name: "Galaxy Tab S10+", img: "/images/devices/galaxy-tab.webp" },
      { name: "Pixel 10 Pro", img: "/images/devices/pixel-10-pro.webp" },
      { name: "OnePlus 13", img: "/images/devices/oneplus-13.webp" },
      { name: "AirPods Max", img: "/images/devices/airpods-max.webp" },
      { name: "PS5", img: "/images/devices/ps5.webp" },
      { name: "Xbox Series X", img: "/images/devices/xbox-series-x.webp" },
    ],
  },
];

const repairTypes = [
  { label: "Écran LCD", icon: `<rect x="5" y="2" width="14" height="20" rx="2"/><line x1="12" y1="18" x2="12.01" y2="18"/><path d="M8 6h8M8 10h5" stroke-dasharray="2 2"/>` },
  { label: "Batterie", icon: `<rect x="6" y="7" width="12" height="10" rx="1"/><line x1="10" y1="7" x2="10" y2="4"/><line x1="14" y1="7" x2="14" y2="4"/><path d="M10 11h4"/>` },
  { label: "Vitre arrière", icon: `<rect x="4" y="2" width="16" height="20" rx="2"/><path d="M4 14h16"/>` },
  { label: "Caméra arrière", icon: `<circle cx="12" cy="12" r="3"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2"/>` },
  { label: "Face ID / Capteurs", icon: `<rect x="6" y="3" width="12" height="18" rx="2"/><circle cx="12" cy="7" r="1.5"/>` },
  { label: "Connecteur de charge", icon: `<path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>` },
  { label: "Oxydation", icon: `<path d="M12 2.69l5.66 5.66a8 8 0 11-11.31 0z"/>` },
  { label: "Haut-parleur / Micro", icon: `<path d="M11 5L6 9H2v6h4l5 4V5z"/><path d="M15.54 8.46a5 5 0 010 7.07"/>` },
  { label: "Boutons", icon: `<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3"/>` },
  { label: "Carte mère", icon: `<rect x="2" y="2" width="20" height="20" rx="2"/><rect x="6" y="6" width="4" height="4" rx="0.5"/><rect x="14" y="6" width="4" height="4" rx="0.5"/><rect x="6" y="14" width="4" height="4" rx="0.5"/>` },
  { label: "Antenne / WiFi", icon: `<path d="M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01M1.394 9.393a15.5 15.5 0 0121.213 0M4.726 12.726a10.5 10.5 0 0114.548 0"/>` },
  { label: "Diagnostic complet", icon: `<circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><path d="M8 11h6M11 8v6"/>` },
];
---

<Layout title="Réparations — Choisissez votre appareil | Fatfix">
  <Navbar client:load />

  <!-- Hero -->
  <section class="py-14 lg:py-18 bg-bg-alt">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="max-w-3xl" data-reveal>
        <h1 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight">Réparation de tous vos appareils</h1>
        <p class="mt-4 text-text-muted text-lg leading-relaxed">
          iPhone, Samsung, iPad, MacBook, PS5, Xbox — écran cassé, batterie HS, dégât des eaux, connecteur défaillant. Nos techniciens voient tout ça chaque jour. Trouvez votre appareil et découvrez nos tarifs.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/rdv" class="inline-flex items-center gap-2 rounded-full bg-primary hover:bg-primary-dark px-6 py-3 text-sm font-semibold text-white transition-colors">Prendre rendez-vous</a>
          <a href="/envoi" class="inline-flex items-center gap-2 rounded-full border border-border hover:border-primary px-6 py-3 text-sm font-medium text-text hover:text-primary transition-colors">Envoi postal</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Repair types grid -->
  <section class="py-14 bg-white border-b border-border">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <h2 data-reveal class="font-display text-xl font-bold mb-6">Types de réparations</h2>
      <div data-reveal-children class="grid grid-cols-3 sm:grid-cols-4 lg:grid-cols-6 gap-3">
        {repairTypes.map((item) => (
          <div class="card flex flex-col items-center gap-2 p-4 text-center group cursor-pointer">
            <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-primary/8 group-hover:bg-primary/15 transition-colors">
              <svg class="h-5 w-5 text-primary" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" set:html={item.icon} />
            </div>
            <span class="font-display font-semibold text-text text-xs leading-tight">{item.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Device categories -->
  <section class="py-16">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <h2 data-reveal class="font-display text-xl font-bold mb-10">Choisissez votre appareil</h2>

      {categories.map((cat) => (
        <div class="mb-14" data-reveal>
          <h3 class="font-display text-lg font-bold mb-5 flex items-center gap-3">
            <img src={cat.img} alt={cat.name} class="h-10 w-10 object-contain" />
            {cat.name}
            <span class="text-xs text-text-muted font-normal">({cat.devices.length} modèles)</span>
          </h3>
          <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
            {cat.devices.map((device) => (
              <a href="/prix" class="card group flex flex-col items-center gap-3 p-5 text-center">
                <div class="w-full aspect-square flex items-center justify-center p-3">
                  <img src={device.img} alt={device.name} class="max-h-full max-w-full object-contain transition-transform duration-400 group-hover:scale-110" loading="lazy" />
                </div>
                <span class="font-display font-semibold text-sm text-text">{device.name}</span>
                <span class="text-xs text-primary font-medium opacity-0 group-hover:opacity-100 transition-opacity">Voir les prix →</span>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Photo break -->
  <section class="relative h-56 lg:h-72 overflow-hidden">
    <img src="/images/media/repair-closeup.jpg" alt="Réparation en cours" class="w-full h-full object-cover" />
    <div class="absolute inset-0 bg-gradient-to-r from-bg-dark/70 to-transparent flex items-center">
      <div class="mx-auto max-w-7xl px-6 lg:px-8 w-full">
        <div class="max-w-md" data-reveal>
          <h2 class="font-display text-xl sm:text-2xl font-bold text-white">Vous ne trouvez pas votre modèle ?</h2>
          <p class="mt-2 text-white/70 text-sm">Contactez-nous — nous réparons bien plus que ce qui est listé ici.</p>
          <a href="/contact" class="mt-3 inline-flex items-center gap-1.5 text-sm font-semibold text-accent-light hover:underline">
            Nous contacter
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust row -->
  <section class="py-14 bg-bg-alt">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div data-reveal-children class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {[
          { icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/>`, title: "60 minutes", desc: "Durée moyenne de réparation" },
          { icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/>`, title: "Garantie incluse", desc: "Jusqu'à 12 mois selon la réparation" },
          { icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 013 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 00-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 01-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 003 15h-.75M15 10.5a3 3 0 11-6 0 3 3 0 016 0zm3 0h.008v.008H18V10.5zm-12 0h.008v.008H6V10.5z"/>`, title: "Prix fixe", desc: "Affiché avant intervention" },
          { icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25m-2.25 0h2.25"/>`, title: "Envoi postal", desc: "Partout en Belgique, gratuit" },
        ].map((item) => (
          <div class="flex items-start gap-4">
            <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-primary/10 flex-shrink-0">
              <svg class="h-5 w-5 text-primary" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" set:html={item.icon} />
            </div>
            <div>
              <div class="font-display font-bold text-text text-sm">{item.title}</div>
              <div class="text-xs text-text-muted">{item.desc}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Footer />
</Layout>
