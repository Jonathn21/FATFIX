---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

const store = {
  name: "FastFix Bruxelles",
  address: "Chaussée de Haecht 163, 1030 Schaerbeek",
  phone: "02 219 49 16",
  email: "info@fastfix.be",
  img: "/images/media/store-front.jpg",
  mapLink: "https://maps.google.com/?q=Chaussée+de+Haecht+163+1030+Schaerbeek",
  hours: [
    { day: "Lundi", time: "10:00 – 18:30" },
    { day: "Mardi", time: "10:00 – 18:30" },
    { day: "Mercredi", time: "10:00 – 18:30" },
    { day: "Jeudi", time: "10:00 – 18:30" },
    { day: "Vendredi", time: "10:00 – 18:30" },
    { day: "Samedi", time: "12:00 – 17:00" },
    { day: "Dimanche", time: "Fermé" },
  ],
  features: ["Micro-soudure", "Réparation PS5/Xbox", "Reconditionnés en stock", "Accessoires en vente", "Protection d'écran"],
};
---

<Layout title="Notre boutique — Bruxelles | FastFix">
  <Navbar client:load />

  <!-- Hero -->
  <section class="relative overflow-hidden bg-bg-dark text-white py-16 lg:py-20">
    <div class="absolute inset-0">
      <img src="/images/media/store-front.jpg" alt="" class="w-full h-full object-cover opacity-25" />
      <div class="absolute inset-0 bg-gradient-to-r from-bg-dark via-bg-dark/90 to-bg-dark/70"></div>
    </div>
    <div class="relative mx-auto max-w-7xl px-6 lg:px-8 text-center">
      <h1 data-reveal class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight">Notre boutique</h1>
      <p data-reveal class="mt-4 text-white/60 text-lg max-w-xl mx-auto">
        Située à Schaerbeek, à deux pas de la Gare du Nord. Sans rendez-vous ou avec réservation.
      </p>
    </div>
  </section>

  <!-- Store -->
  <section class="py-16">
    <div class="mx-auto max-w-4xl px-6 lg:px-8">
      <div data-reveal>
        <div class="card overflow-hidden">
          <div class="grid md:grid-cols-2">
            <div class="aspect-video md:aspect-auto overflow-hidden">
              <img src={store.img} alt={store.name} class="w-full h-full object-cover" loading="lazy"/>
            </div>
            <div class="p-8 lg:p-10">
              <h2 class="font-display text-2xl font-bold mb-5">{store.name}</h2>

              <div class="space-y-3 text-sm text-text-muted mb-6">
                <div class="flex items-start gap-3">
                  <svg class="h-5 w-5 text-primary flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/></svg>
                  <span>{store.address}</span>
                </div>
                <div class="flex items-center gap-3">
                  <svg class="h-5 w-5 text-primary flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/></svg>
                  <a href="tel:+3222194916" class="hover:text-primary transition-colors font-medium">{store.phone}</a>
                </div>
                <div class="flex items-center gap-3">
                  <svg class="h-5 w-5 text-primary flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/></svg>
                  <a href="mailto:info@fastfix.be" class="hover:text-primary transition-colors">{store.email}</a>
                </div>
              </div>

              <h3 class="font-display font-semibold text-sm mb-3">Heures d'ouverture</h3>
              <div class="rounded-xl border border-border overflow-hidden mb-5">
                {store.hours.map((h, i) => (
                  <div class={`flex justify-between px-4 py-2 text-sm ${i < store.hours.length - 1 ? "border-b border-border" : ""} ${h.time === "Fermé" ? "text-text-muted" : "text-text"}`}>
                    <span class="font-medium">{h.day}</span>
                    <span>{h.time}</span>
                  </div>
                ))}
              </div>

              <h3 class="font-display font-semibold text-sm mb-2">Disponible dans cette boutique</h3>
              <div class="flex flex-wrap gap-2 mb-6">
                {store.features.map((f) => (
                  <span class="badge text-xs">{f}</span>
                ))}
              </div>

              <div class="flex flex-wrap gap-3">
                <a href="/rdv" class="inline-flex items-center gap-2 rounded-full bg-primary hover:bg-primary-dark px-5 py-2.5 text-sm font-semibold text-white transition-colors">Prendre RDV</a>
                <a href={store.mapLink} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-full border border-border hover:border-primary px-5 py-2.5 text-sm font-medium text-text hover:text-primary transition-colors">
                  Itinéraire
                  <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25"/></svg>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- What to bring -->
      <div class="mt-12 grid sm:grid-cols-3 gap-6" data-reveal-children>
        {[
          { icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M10.5 1.5H8.25A2.25 2.25 0 006 3.75v16.5a2.25 2.25 0 002.25 2.25h7.5A2.25 2.25 0 0018 20.25V3.75a2.25 2.25 0 00-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3"/>`, title: "Quoi apporter ?", desc: "Juste votre appareil. Pas besoin de chargeur, câble ou boîte. Nous avons tout le nécessaire." },
          { icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/>`, title: "Combien de temps ?", desc: "La plupart des réparations sont terminées en 60 minutes. Vous pouvez attendre sur place ou revenir." },
          { icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 013 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75"/>`, title: "Moyens de paiement", desc: "Cash, Bancontact, carte de crédit et paiement mobile (Apple Pay, Google Pay)." },
        ].map((item) => (
          <div class="card p-6">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-primary/10 mb-3">
              <svg class="h-5 w-5 text-primary" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" set:html={item.icon} />
            </div>
            <h3 class="font-display font-bold text-sm mb-1">{item.title}</h3>
            <p class="text-xs text-text-muted leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>

      <!-- Mail option -->
      <div class="mt-10 card p-8 text-center" data-reveal>
        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-accent/10 mx-auto mb-4">
          <svg class="h-6 w-6 text-accent" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/></svg>
        </div>
        <h3 class="font-display text-xl font-bold mb-2">Trop loin pour vous déplacer ?</h3>
        <p class="text-text-muted text-sm mb-5 max-w-md mx-auto">
          Envoyez votre appareil par la poste et nous le réparons sous 3 à 5 jours ouvrés. Étiquette prépayée incluse.
        </p>
        <a href="/envoi" class="inline-flex items-center gap-2 rounded-full bg-accent hover:bg-accent/90 px-6 py-3 text-sm font-semibold text-white transition-colors">
          Découvrir l'envoi postal
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
        </a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
