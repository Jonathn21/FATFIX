---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar";
import Footer from "../components/Footer.astro";
import ContentList from "../components/ContentList";
import "../styles/global.css";

// Icônes des cartes « Ce qui nous guide », réutilisées par position.
const VALUE_ICONS = [
  "M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z",
  "M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z",
  "M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z",
  "M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z",
  "M12 3v17.25m0 0c-1.472 0-2.882.265-4.185.75M12 20.25c1.472 0 2.882.265 4.185.75M18.75 4.97A48.416 48.416 0 0012 4.5c-2.291 0-4.545.16-6.75.47m13.5 0c1.01.143 2.01.317 3 .52",
  "M4.26 10.147a60.436 60.436 0 00-.491 6.347A48.627 48.627 0 0112 20.904a48.627 48.627 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.57 50.57 0 00-2.658-.813A59.905 59.905 0 0112 3.493a59.902 59.902 0 0110.399 5.84c-.896.248-1.783.52-2.658.814",
];
---

<Layout title="À propos — FastFix">
  <Navbar client:load />

  <!-- Hero -->
  <section class="relative overflow-hidden bg-bg-dark text-white py-20 lg:py-28">
    <div class="absolute inset-0">
      <img src="/images/media/workshop.jpg" alt="" class="w-full h-full object-cover opacity-20" />
      <div class="absolute inset-0 bg-gradient-to-b from-bg-dark/80 to-bg-dark"></div>
    </div>
    <div class="relative mx-auto max-w-7xl px-6 lg:px-8 text-center">
      <h1 data-reveal data-ff-content="a-propos.hero.title" class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight">
        Passionnés de tech,<br/>experts de la réparation
      </h1>
      <p data-reveal data-ff-content="a-propos.hero.text" class="mt-5 text-white/60 text-lg max-w-2xl mx-auto">
        Depuis 2002, notre équipe de techniciens certifiés redonne vie à vos appareils. Rapidement, proprement, durablement.
      </p>
    </div>
  </section>

  <!-- Stats -->
  <section class="relative -mt-10 z-10 mx-auto max-w-4xl px-6 lg:px-8">
    <div data-reveal-children class="grid grid-cols-2 md:grid-cols-4 gap-4">
      {[
        { value: "30 000+", label: "Appareils réparés" },
        { value: "98%", label: "Clients satisfaits" },
        { value: "20+", label: "Années d'expérience" },
        { value: "1", label: "Boutique à Bruxelles" },
      ].map((stat) => (
        <div class="card p-6 text-center">
          <span class="font-display text-2xl sm:text-3xl font-bold text-primary">{stat.value}</span>
          <span class="block text-xs text-text-muted mt-1">{stat.label}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- Story -->
  <section class="py-20">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-14 items-center">
        <div data-reveal>
          <span data-ff-content="a-propos.story.badge" class="badge badge-purple mb-4">Notre histoire</span>
          <h2 data-ff-content="a-propos.story.title" class="font-display text-2xl sm:text-3xl font-bold mb-6">De la passion à l'expertise</h2>
          <div class="space-y-4 text-text-muted leading-relaxed">
            <p>
              FastFix, c'est l'enseigne réparation de Hascom Computer. Depuis 2002, nous sommes installés à Schaerbeek avec un objectif clair — offrir des réparations de qualité, rapides et à prix juste.
            </p>
            <p>
              Avec plus de 30 000 réparations à notre actif, nous traitons smartphones, tablettes, ordinateurs, consoles et montres connectées. Chaque pièce est testée, chaque intervention est garantie. Nous investissons continuellement dans la formation et les outils pour rester à la pointe : micro-soudure, diagnostic carte mère, réparation de composants CMS.
            </p>
            <p>
              Notre philosophie n'a pas changé : transparence, rapidité, et un service client qui fait la différence.
            </p>
          </div>
        </div>
        <div data-reveal class="grid grid-cols-2 gap-4">
          <img src="/images/media/store-front.jpg" alt="Boutique FastFix" class="rounded-2xl w-full h-48 object-cover" loading="lazy" />
          <img src="/images/media/micro-soldering.jpg" alt="Micro-soudure" class="rounded-2xl w-full h-48 object-cover mt-8" loading="lazy" />
          <img src="/images/media/repair-closeup.jpg" alt="Réparation" class="rounded-2xl w-full h-48 object-cover" loading="lazy" />
          <img src="/images/media/store-counter.jpg" alt="Comptoir" class="rounded-2xl w-full h-48 object-cover mt-8" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="py-20 bg-bg-alt">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="text-center mb-14" data-reveal>
        <h2 class="font-display text-2xl sm:text-3xl font-bold" data-ff-content="a-propos.sections.values_title">Ce qui nous guide</h2>
      </div>
      <ContentList
        contentKey="a-propos.lists.values"
        variant="cards"
        icons={VALUE_ICONS}
        fallback={[
          ["Transparence totale", "Prix affichés, devis gratuit, pas de frais cachés. Vous savez exactement ce que vous payez avant toute intervention."],
          ["Rapidité", "90% de nos réparations sont terminées en 60 minutes. Nous respectons votre temps."],
          ["Excellence", "Techniciens formés, pièces certifiées, tests avant et après. Chaque appareil sort de chez nous vérifié et garanti."],
          ["Proximité", "Nous sommes accessibles, réactifs et à l'écoute. Nos boutiques sont des lieux accueillants."],
          ["Responsabilité", "Réparer plutôt que jeter. Chaque appareil réparé, c'est un appareil de moins dans une décharge."],
          ["Formation continue", "Nos techniciens suivent des formations chaque trimestre pour maîtriser les derniers modèles."],
        ]}
        client:load
      />
    </div>
  </section>

  <!-- Team photo break -->
  <section class="relative h-64 lg:h-80 overflow-hidden">
    <img src="/images/media/workshop.jpg" alt="L'atelier FastFix" class="w-full h-full object-cover" />
    <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent flex items-end">
      <div class="mx-auto max-w-7xl px-6 lg:px-8 pb-8 w-full">
        <p class="font-display text-white text-xl font-bold">Notre atelier — le cœur de FastFix</p>
      </div>
    </div>
  </section>

  <!-- Certifications -->
  <section class="py-20">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="text-center mb-14" data-reveal>
        <h2 class="font-display text-2xl sm:text-3xl font-bold" data-ff-content="a-propos.sections.certs_title">Certifications &amp; partenaires</h2>
        <p class="mt-3 text-text-muted">Des standards élevés, validés par les constructeurs.</p>
      </div>
      <ContentList
        contentKey="a-propos.lists.certifications"
        variant="cards"
        fallback={[
          ["Réparateur Agréé Apple", "Pièces d'origine Apple, outils certifiés, procédures constructeur."],
          ["Samsung Partenaire", "Accès direct aux pièces Samsung d'origine pour Galaxy S et A."],
          ["ISO 9001", "Système de management qualité certifié pour nos processus de réparation."],
          ["Eco-Réparateur", "Label de réparation durable pour la réduction des déchets électroniques."],
        ]}
        client:load
      />
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 bg-bg-alt">
    <div class="mx-auto max-w-3xl px-6 lg:px-8 text-center" data-reveal>
      <h2 class="font-display text-2xl sm:text-3xl font-bold" data-ff-content="a-propos.sections.join_title">Envie de rejoindre l'équipe ?</h2>
      <p class="mt-4 text-text-muted">Nous cherchons toujours des techniciens passionnés. Envoyez-nous votre CV.</p>
      <a href="/contact" class="mt-6 inline-flex items-center gap-2 rounded-full bg-primary hover:bg-primary-dark px-7 py-3.5 text-sm font-semibold text-white transition-colors shadow-md">
        <span data-ff-content="a-propos.sections.join_cta">Postuler</span>
      </a>
    </div>
  </section>

  <Footer />
</Layout>
