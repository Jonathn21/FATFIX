---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar";
import Footer from "../components/Footer.astro";
import PriceCards from "../components/PriceCards";
import PriceGrid from "../components/PriceGrid";
import ContentList from "../components/ContentList";
import "../styles/global.css";

// Images livrées avec le site, conservées comme repli quand un modèle n'a pas
// encore de photo dans le catalogue WordPress (FastFix → Appareils).
const POPULAR_IMAGES: Record<string, string> = {
  "Écran iPhone 16": "/images/devices/iphone-16.webp",
  "Batterie iPhone 17 Pro": "/images/devices/iphone-17-pro.webp",
  "Écran Galaxy S26 Ultra": "/images/devices/galaxy-s26-ultra.webp",
  "Batterie iPhone 16 Pro Max": "/images/devices/iphone-16-pro-max.webp",
  "Écran iPad Pro M5": "/images/devices/ipad-pro-m5.webp",
  "Vitre arrière iPhone 17": "/images/devices/iphone-17.webp",
  "Batterie Galaxy S24": "/images/devices/galaxy-s24.webp",
  "Écran MacBook Air M4": "/images/devices/macbook-air.webp",
};

const MODEL_IMAGES: Record<string, string> = {
  "iPhone 17 Pro Max": "/images/devices/iphone-17-pro-max.webp",
  "iPhone 17 Pro": "/images/devices/iphone-17-pro.webp",
  "iPhone 17": "/images/devices/iphone-17.webp",
  "iPhone 16 Pro Max": "/images/devices/iphone-16-pro-max.webp",
  "iPhone 16": "/images/devices/iphone-16.webp",
  "Galaxy S26 Ultra": "/images/devices/galaxy-s26-ultra.webp",
  "Galaxy S26+": "/images/devices/galaxy-s26-plus.webp",
  "Galaxy S26": "/images/devices/galaxy-s26.webp",
  "Galaxy S24": "/images/devices/galaxy-s24.webp",
  "Galaxy S23 Ultra": "/images/devices/galaxy-s23-ultra.webp",
  "iPad Pro 13\" M5": "/images/devices/ipad-pro-m5.webp",
  "iPad Pro 13\" M4": "/images/devices/ipad-pro.webp",
  "MacBook Air M4": "/images/devices/macbook-air.webp",
  "Apple Watch": "/images/devices/apple-watch.webp",
  "Galaxy Tab S10+": "/images/devices/galaxy-tab.webp",
  "PS5": "/images/devices/ps5.webp",
  "Xbox Series X": "/images/devices/xbox-series-x.webp",
};
---

<Layout title="Tous les prix — Réparations iPhone, Samsung & plus | FastFix">
  <Navbar client:load />

  <!-- Hero -->
  <section class="py-14 lg:py-18 bg-bg-alt">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-10 items-center" data-reveal>
        <div>
          <h1 data-ff-content="prix.hero.title" class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight">Nos tarifs</h1>
          <p data-ff-content="prix.hero.text" class="mt-4 text-text-muted text-lg leading-relaxed">
            Prix fixes, transparents, affichés avant intervention. Pièces certifiées et garantie incluse sur chaque réparation.
          </p>
          <div class="flex flex-wrap gap-4 mt-6">
            <a href="/rdv" class="inline-flex items-center gap-2 rounded-full bg-primary hover:bg-primary-dark px-6 py-3 text-sm font-semibold text-white transition-colors"><span data-ff-content="prix.hero.cta_primary">Prendre rendez-vous</span></a>
            <a href="/contact" class="inline-flex items-center gap-2 rounded-full border border-border hover:border-primary px-6 py-3 text-sm font-medium text-text hover:text-primary transition-colors"><span data-ff-content="prix.hero.cta_secondary">Devis personnalisé</span></a>
          </div>
        </div>
        <div class="flex justify-center gap-2 sm:gap-3">
          <img src="/images/devices/iphone-17-pro-max.webp" alt="iPhone" class="h-20 sm:h-28 md:h-32 lg:h-48 object-contain" />
          <img src="/images/devices/galaxy-s26-ultra.webp" alt="Samsung" class="h-16 sm:h-24 md:h-28 lg:h-44 object-contain mt-4 sm:mt-6" />
          <img src="/images/devices/macbook-air.webp" alt="MacBook" class="h-12 sm:h-16 md:h-20 lg:h-32 object-contain mt-8 sm:mt-12" />
        </div>
      </div>
    </div>
  </section>

  <!-- Trust -->
  <section class="bg-white border-b border-border">
    <div class="mx-auto max-w-7xl px-6 lg:px-8 py-5">
      <div class="flex flex-col sm:flex-row flex-wrap items-center justify-center gap-4 sm:gap-8 text-sm text-text-muted">
        {[
          { icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 013 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75"/>`, text: "Prix = prix final, sans surprise" },
          { icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/>`, text: "Garantie incluse" },
          { icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/>`, text: "Réparation express" },
          { icon: `<circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>`, text: "Diagnostic gratuit" },
        ].map((item) => (
          <span class="flex items-center gap-2">
            <svg class="h-4 w-4 text-accent" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" set:html={item.icon} />
            {item.text}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- Popular repairs with images -->
  <section class="py-16">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <h2 data-reveal class="font-display text-2xl font-bold mb-8" data-ff-content="prix.sections.popular_title">Réparations populaires</h2>
      <PriceCards
        images={POPULAR_IMAGES}
        fallback={[
          ["Écran iPhone 16", "± 1h", "12 mois", "179"],
          ["Batterie iPhone 17 Pro", "± 1h", "6 mois", "109"],
          ["Écran Galaxy S26 Ultra", "± 1.5h", "12 mois", "289"],
          ["Batterie iPhone 16 Pro Max", "± 1h", "6 mois", "99"],
          ["Écran iPad Pro M5", "± 2h", "12 mois", "349"],
          ["Vitre arrière iPhone 17", "± 1h", "12 mois", "79"],
          ["Batterie Galaxy S24", "± 1h", "6 mois", "89"],
          ["Écran MacBook Air M4", "± 3h", "12 mois", "399"],
        ]}
        client:load
      />
    </div>
  </section>

  <!-- Category tables with device images -->
  <section class="py-16 bg-bg-alt">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <h2 data-reveal class="font-display text-2xl font-bold mb-10" data-ff-content="prix.sections.all_title">Tous les tarifs par catégorie</h2>

      <PriceGrid
        images={MODEL_IMAGES}
        fallback={[
          { name: "iPhone", logo: "/images/brands/apple.svg", rows: [
            ["iPhone 17 Pro Max", "249", "109", "89", "149"],
            ["iPhone 17 Pro", "229", "109", "89", "139"],
            ["iPhone 17", "199", "99", "79", "119"],
            ["iPhone 16 Pro Max", "219", "99", "79", "129"],
            ["iPhone 16", "179", "89", "69", "109"],
          ]},
          { name: "Samsung Galaxy", logo: "/images/brands/samsung.svg", rows: [
            ["Galaxy S26 Ultra", "289", "119", "89", "159"],
            ["Galaxy S26+", "249", "109", "79", "139"],
            ["Galaxy S26", "229", "99", "79", "129"],
            ["Galaxy S24", "199", "89", "69", "109"],
            ["Galaxy S23 Ultra", "219", "99", "69", "129"],
          ]},
          { name: "iPad & MacBook", logo: "/images/brands/apple.svg", rows: [
            ["iPad Pro 13\" M5", "349", "149", "", "129"],
            ["iPad Pro 13\" M4", "329", "139", "", "119"],
            ["MacBook Air M4", "399", "199", "", ""],
          ]},
          { name: "Autres appareils", logo: null, rows: [
            ["Apple Watch", "149", "89", "", ""],
            ["Galaxy Tab S10+", "249", "119", "", ""],
            ["PS5", "", "", "", ""],
            ["Xbox Series X", "", "", "", ""],
          ]},
        ]}
        client:load
      />
    </div>
  </section>

  <!-- Other repairs -->
  <section class="py-16">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="text-center mb-10" data-reveal>
        <h2 class="font-display text-2xl font-bold" data-ff-content="prix.sections.other_title">Autres réparations</h2>
        <p data-ff-content="prix.other.subtitle" class="mt-3 text-text-muted">Tarifs indicatifs pour les interventions spécifiques.</p>
      </div>
      <ContentList
        contentKey="prix.other.items"
        variant="priceRows"
        fallback={[
          ["Connecteur de charge", "49 – 89 €", "± 1h"],
          ["Haut-parleur", "39 – 69 €", "± 45 min"],
          ["Micro", "39 – 69 €", "± 45 min"],
          ["Face ID (iPhone)", "129 – 179 €", "± 1.5h"],
          ["Bouton power / volume", "39 – 59 €", "± 1h"],
          ["Nettoyage oxydation", "59 – 99 €", "± 2h"],
          ["Antenne / WiFi", "49 – 89 €", "± 1h"],
          ["Carte mère (diagnostic)", "à partir de 99 €", "± 2-5 jours"],
          ["Micro-soudure", "à partir de 79 €", "± 1-3 jours"],
        ]}
        client:load
      />
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 bg-bg-dark text-white">
    <div class="mx-auto max-w-3xl px-6 lg:px-8 text-center" data-reveal>
      <h2 class="font-display text-2xl sm:text-3xl font-bold" data-ff-content="prix.sections.not_listed_title">Votre modèle n'est pas listé ?</h2>
      <p class="mt-4 text-white/60">Nous réparons bien plus que ce qui est affiché. Contactez-nous pour un devis gratuit et sans engagement.</p>
      <div class="mt-6 flex flex-wrap justify-center gap-4">
        <a href="/contact" class="inline-flex items-center gap-2 rounded-full bg-primary hover:bg-primary-dark px-7 py-3.5 text-sm font-semibold text-white transition-colors">Demander un devis</a>
        <a href="tel:+3222194916" class="inline-flex items-center gap-2 rounded-full bg-white/10 border border-white/20 hover:bg-white/20 px-7 py-3.5 text-sm font-semibold text-white transition-all">Appeler</a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
