---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

const popular = [
  { repair: "Écran iPhone 16", img: "/images/devices/iphone-16.webp", time: "± 1h", warranty: "12 mois", price: 179 },
  { repair: "Batterie iPhone 17 Pro", img: "/images/devices/iphone-17-pro.webp", time: "± 1h", warranty: "6 mois", price: 109 },
  { repair: "Écran Galaxy S26 Ultra", img: "/images/devices/galaxy-s26-ultra.webp", time: "± 1.5h", warranty: "12 mois", price: 289 },
  { repair: "Batterie iPhone 16 Pro Max", img: "/images/devices/iphone-16-pro-max.webp", time: "± 1h", warranty: "6 mois", price: 99 },
  { repair: "Écran iPad Pro M5", img: "/images/devices/ipad-pro-m5.webp", time: "± 2h", warranty: "12 mois", price: 349 },
  { repair: "Vitre arrière iPhone 17", img: "/images/devices/iphone-17.webp", time: "± 1h", warranty: "12 mois", price: 79 },
  { repair: "Batterie Galaxy S24", img: "/images/devices/galaxy-s24.webp", time: "± 1h", warranty: "6 mois", price: 89 },
  { repair: "Écran MacBook Air M4", img: "/images/devices/macbook-air.webp", time: "± 3h", warranty: "12 mois", price: 399 },
];

const categories = [
  {
    name: "iPhone",
    brandLogo: "/images/brands/apple.svg",
    repairs: [
      { model: "iPhone 17 Pro Max", img: "/images/devices/iphone-17-pro-max.webp", screen: 249, battery: 109, back: 89, camera: 149 },
      { model: "iPhone 17 Pro", img: "/images/devices/iphone-17-pro.webp", screen: 229, battery: 109, back: 89, camera: 139 },
      { model: "iPhone 17", img: "/images/devices/iphone-17.webp", screen: 199, battery: 99, back: 79, camera: 119 },
      { model: "iPhone 16 Pro Max", img: "/images/devices/iphone-16-pro-max.webp", screen: 219, battery: 99, back: 79, camera: 129 },
      { model: "iPhone 16", img: "/images/devices/iphone-16.webp", screen: 179, battery: 89, back: 69, camera: 109 },
    ],
  },
  {
    name: "Samsung Galaxy",
    brandLogo: "/images/brands/samsung.svg",
    repairs: [
      { model: "Galaxy S26 Ultra", img: "/images/devices/galaxy-s26-ultra.webp", screen: 289, battery: 119, back: 89, camera: 159 },
      { model: "Galaxy S26+", img: "/images/devices/galaxy-s26-plus.webp", screen: 249, battery: 109, back: 79, camera: 139 },
      { model: "Galaxy S26", img: "/images/devices/galaxy-s26.webp", screen: 229, battery: 99, back: 79, camera: 129 },
      { model: "Galaxy S24", img: "/images/devices/galaxy-s24.webp", screen: 199, battery: 89, back: 69, camera: 109 },
      { model: "Galaxy S23 Ultra", img: "/images/devices/galaxy-s23-ultra.webp", screen: 219, battery: 99, back: 69, camera: 129 },
    ],
  },
  {
    name: "iPad & MacBook",
    brandLogo: "/images/brands/apple.svg",
    repairs: [
      { model: "iPad Pro 13\" M5", img: "/images/devices/ipad-pro-m5.webp", screen: 349, battery: 149, back: null, camera: 129 },
      { model: "iPad Pro 13\" M4", img: "/images/devices/ipad-pro.webp", screen: 329, battery: 139, back: null, camera: 119 },
      { model: "MacBook Air M4", img: "/images/devices/macbook-air.webp", screen: 399, battery: 199, back: null, camera: null },
    ],
  },
  {
    name: "Autres appareils",
    brandLogo: null,
    repairs: [
      { model: "Apple Watch", img: "/images/devices/apple-watch.webp", screen: 149, battery: 89, back: null, camera: null },
      { model: "Galaxy Tab S10+", img: "/images/devices/galaxy-tab.webp", screen: 249, battery: 119, back: null, camera: null },
      { model: "PS5", img: "/images/devices/ps5.webp", screen: null, battery: null, back: null, camera: null },
      { model: "Xbox Series X", img: "/images/devices/xbox-series-x.webp", screen: null, battery: null, back: null, camera: null },
    ],
  },
];
---

<Layout title="Tous les prix — Réparations iPhone, Samsung & plus | FastFix">
  <Navbar client:load />

  <!-- Hero -->
  <section class="py-14 lg:py-18 bg-bg-alt">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-10 items-center" data-reveal>
        <div>
          <h1 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight">Nos tarifs</h1>
          <p class="mt-4 text-text-muted text-lg leading-relaxed">
            Prix fixes, transparents, affichés avant intervention. Pièces certifiées et garantie incluse sur chaque réparation.
          </p>
          <div class="flex flex-wrap gap-4 mt-6">
            <a href="/rdv" class="inline-flex items-center gap-2 rounded-full bg-primary hover:bg-primary-dark px-6 py-3 text-sm font-semibold text-white transition-colors">Prendre rendez-vous</a>
            <a href="/contact" class="inline-flex items-center gap-2 rounded-full border border-border hover:border-primary px-6 py-3 text-sm font-medium text-text hover:text-primary transition-colors">Devis personnalisé</a>
          </div>
        </div>
        <div class="flex justify-center gap-2 sm:gap-3">
          <img src="/images/devices/iphone-17-pro-max.webp" alt="iPhone" class="h-20 sm:h-28 md:h-32 lg:h-48 object-contain" />
          <img src="/images/devices/galaxy-s26-ultra.webp" alt="Samsung" class="h-16 sm:h-24 md:h-28 lg:h-44 object-contain mt-4 sm:mt-6" />
          <img src="/images/devices/macbook-air.webp" alt="MacBook" class="h-12 sm:h-16 md:h-20 lg:h-32 object-contain mt-8 sm:mt-12" />
        </div>
      </div>
    </div>
  </section>

  <!-- Trust -->
  <section class="bg-white border-b border-border">
    <div class="mx-auto max-w-7xl px-6 lg:px-8 py-5">
      <div class="flex flex-col sm:flex-row flex-wrap items-center justify-center gap-4 sm:gap-8 text-sm text-text-muted">
        {[
          { icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 013 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75"/>`, text: "Prix = prix final, sans surprise" },
          { icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/>`, text: "Garantie incluse" },
          { icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/>`, text: "Réparation express" },
          { icon: `<circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>`, text: "Diagnostic gratuit" },
        ].map((item) => (
          <span class="flex items-center gap-2">
            <svg class="h-4 w-4 text-accent" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" set:html={item.icon} />
            {item.text}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- Popular repairs with images -->
  <section class="py-16">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <h2 data-reveal class="font-display text-2xl font-bold mb-8">Réparations populaires</h2>
      <div data-reveal-children class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {popular.map((r) => (
          <div class="card group overflow-hidden">
            <div class="aspect-square bg-bg-alt p-6 flex items-center justify-center">
              <img src={r.img} alt={r.repair} class="h-32 w-auto object-contain transition-transform duration-300 group-hover:scale-105" loading="lazy" />
            </div>
            <div class="p-5">
              <h3 class="font-display font-bold text-sm mb-2">{r.repair}</h3>
              <div class="flex items-center gap-2 mb-3">
                <span class="badge badge-purple text-xs">
                  <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                  {r.time}
                </span>
                <span class="badge badge-green text-xs">
                  <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/></svg>
                  {r.warranty}
                </span>
              </div>
              <div class="flex items-center justify-between">
                <span class="font-display text-xl font-bold text-primary">€ {r.price}</span>
                <a href="/rdv" class="text-xs font-semibold text-primary hover:underline">Réserver →</a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Category tables with device images -->
  <section class="py-16 bg-bg-alt">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <h2 data-reveal class="font-display text-2xl font-bold mb-10">Tous les tarifs par catégorie</h2>

      {categories.map((cat) => (
        <div class="mb-14" data-reveal>
          <div class="flex items-center gap-3 mb-6">
            {cat.brandLogo && <img src={cat.brandLogo} alt="" class="h-6 opacity-50" style="filter: brightness(0);" />}
            <h3 class="font-display text-xl font-bold">{cat.name}</h3>
          </div>

          <!-- Card grid for each model -->
          <div class="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-4">
            {cat.repairs.map((r) => (
              <div class="card overflow-hidden">
                <div class="bg-white p-4 flex items-center justify-center h-36">
                  <img src={r.img} alt={r.model} class="h-28 w-auto object-contain" loading="lazy" />
                </div>
                <div class="p-4 bg-bg-alt border-t border-border">
                  <h4 class="font-display font-bold text-sm mb-3">{r.model}</h4>
                  <div class="space-y-2 text-xs">
                    {r.screen && (
                      <div class="flex items-center justify-between">
                        <span class="text-text-muted flex items-center gap-1.5">
                          <svg class="h-3 w-3 text-primary" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><rect x="5" y="2" width="14" height="20" rx="2"/></svg>
                          Écran
                        </span>
                        <span class="font-display font-bold text-primary">€ {r.screen}</span>
                      </div>
                    )}
                    {r.battery && (
                      <div class="flex items-center justify-between">
                        <span class="text-text-muted flex items-center gap-1.5">
                          <svg class="h-3 w-3 text-primary" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><rect x="6" y="7" width="12" height="10" rx="1"/><line x1="10" y1="7" x2="10" y2="4"/><line x1="14" y1="7" x2="14" y2="4"/></svg>
                          Batterie
                        </span>
                        <span class="font-display font-bold text-primary">€ {r.battery}</span>
                      </div>
                    )}
                    {r.back && (
                      <div class="flex items-center justify-between">
                        <span class="text-text-muted flex items-center gap-1.5">
                          <svg class="h-3 w-3 text-primary" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><rect x="4" y="2" width="16" height="20" rx="2"/></svg>
                          Vitre arr.
                        </span>
                        <span class="font-display font-bold text-primary">€ {r.back}</span>
                      </div>
                    )}
                    {r.camera && (
                      <div class="flex items-center justify-between">
                        <span class="text-text-muted flex items-center gap-1.5">
                          <svg class="h-3 w-3 text-primary" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><circle cx="12" cy="12" r="3"/></svg>
                          Caméra
                        </span>
                        <span class="font-display font-bold text-primary">€ {r.camera}</span>
                      </div>
                    )}
                    {!r.screen && !r.battery && (
                      <div class="text-center py-1">
                        <a href="/contact" class="text-primary font-semibold hover:underline">Devis sur demande</a>
                      </div>
                    )}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Other repairs -->
  <section class="py-16">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="text-center mb-10" data-reveal>
        <h2 class="font-display text-2xl font-bold">Autres réparations</h2>
        <p class="mt-3 text-text-muted">Tarifs indicatifs pour les interventions spécifiques.</p>
      </div>
      <div data-reveal-children class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 max-w-4xl mx-auto">
        {[
          { repair: "Connecteur de charge", price: "49 – 89 €", time: "± 1h" },
          { repair: "Haut-parleur", price: "39 – 69 €", time: "± 45 min" },
          { repair: "Micro", price: "39 – 69 €", time: "± 45 min" },
          { repair: "Face ID (iPhone)", price: "129 – 179 €", time: "± 1.5h" },
          { repair: "Bouton power / volume", price: "39 – 59 €", time: "± 1h" },
          { repair: "Nettoyage oxydation", price: "59 – 99 €", time: "± 2h" },
          { repair: "Antenne / WiFi", price: "49 – 89 €", time: "± 1h" },
          { repair: "Carte mère (diagnostic)", price: "à partir de 99 €", time: "± 2-5 jours" },
          { repair: "Micro-soudure", price: "à partir de 79 €", time: "± 1-3 jours" },
        ].map((r) => (
          <div class="flex items-center justify-between p-4 rounded-xl border border-border bg-white hover:border-primary/30 transition-colors">
            <div>
              <span class="font-display font-semibold text-sm text-text">{r.repair}</span>
              <span class="block text-xs text-text-muted mt-0.5">{r.time}</span>
            </div>
            <span class="font-display font-bold text-sm text-primary whitespace-nowrap">{r.price}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 bg-bg-dark text-white">
    <div class="mx-auto max-w-3xl px-6 lg:px-8 text-center" data-reveal>
      <h2 class="font-display text-2xl sm:text-3xl font-bold">Votre modèle n'est pas listé ?</h2>
      <p class="mt-4 text-white/60">Nous réparons bien plus que ce qui est affiché. Contactez-nous pour un devis gratuit et sans engagement.</p>
      <div class="mt-6 flex flex-wrap justify-center gap-4">
        <a href="/contact" class="inline-flex items-center gap-2 rounded-full bg-primary hover:bg-primary-dark px-7 py-3.5 text-sm font-semibold text-white transition-colors">Demander un devis</a>
        <a href="tel:+3222194916" class="inline-flex items-center gap-2 rounded-full bg-white/10 border border-white/20 hover:bg-white/20 px-7 py-3.5 text-sm font-semibold text-white transition-all">Appeler</a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
