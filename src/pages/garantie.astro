---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
---

<Layout title="Garantie — Fatfix">
  <Navbar client:load />

  <!-- Hero -->
  <section class="py-16 lg:py-20">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center" data-reveal>
        <div class="flex h-16 w-16 mx-auto items-center justify-center rounded-2xl bg-accent/10 mb-6">
          <svg class="h-8 w-8 text-accent" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/></svg>
        </div>
        <h1 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight">Notre garantie</h1>
        <p class="mt-5 text-text-muted text-lg max-w-2xl mx-auto">
          Chaque réparation chez Fatfix est couverte par une garantie. Si un problème survient après notre intervention, nous le prenons en charge — sans frais supplémentaires.
        </p>
      </div>
    </div>
  </section>

  <!-- Warranty tiers -->
  <section class="py-10">
    <div class="mx-auto max-w-5xl px-6 lg:px-8">
      <div data-reveal-children class="grid md:grid-cols-3 gap-6">
        {[
          { duration: "3 mois", label: "Standard", types: "Diagnostic, nettoyage oxydation, petites interventions", color: "bg-bg-alt border-border" },
          { duration: "6 mois", label: "Étendue", types: "Batterie, connecteur de charge, haut-parleur, micro, boutons", color: "bg-primary/5 border-primary/20" },
          { duration: "12 mois", label: "Premium", types: "Écran (LCD complet), vitre arrière, caméra, Face ID", color: "bg-accent/5 border-accent/20" },
        ].map((tier) => (
          <div class={`card p-7 border-2 ${tier.color}`}>
            <span class="font-display text-3xl font-bold text-primary">{tier.duration}</span>
            <h3 class="font-display text-lg font-bold mt-2 mb-3">{tier.label}</h3>
            <p class="text-sm text-text-muted leading-relaxed">{tier.types}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- What's covered -->
  <section class="py-20 bg-bg-alt">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-14">
        <div data-reveal>
          <h2 class="font-display text-2xl font-bold mb-6 flex items-center gap-3">
            <svg class="h-6 w-6 text-accent" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
            Ce qui est couvert
          </h2>
          <ul class="space-y-4">
            {[
              "Défaut de la pièce installée (écran, batterie, etc.)",
              "Défaut de montage ou de main-d'œuvre",
              "Dysfonctionnement apparu suite à notre intervention",
              "Problème de connectivité lié à la réparation",
              "Pièce de remplacement identique ou supérieure",
              "Main-d'œuvre gratuite sur la réparation garantie",
            ].map((item) => (
              <li class="flex items-start gap-3 text-sm">
                <svg class="h-5 w-5 text-accent flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
                <span class="text-text-light">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        <div data-reveal>
          <h2 class="font-display text-2xl font-bold mb-6 flex items-center gap-3">
            <svg class="h-6 w-6 text-red-500" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
            Ce qui n'est pas couvert
          </h2>
          <ul class="space-y-4">
            {[
              "Dommages causés par une chute, un choc ou un écrasement après la réparation",
              "Dégât des eaux survenu après la réparation",
              "Ouverture de l'appareil par un tiers après notre intervention",
              "Utilisation de logiciels non officiels ayant causé un dysfonctionnement",
              "Usure normale de la pièce (ex : capacité de batterie qui diminue avec le temps)",
              "Panne d'un composant non lié à notre intervention",
            ].map((item) => (
              <li class="flex items-start gap-3 text-sm">
                <svg class="h-5 w-5 text-red-500 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                <span class="text-text-light">{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- How to claim -->
  <section class="py-20">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="text-center mb-14" data-reveal>
        <h2 class="font-display text-2xl sm:text-3xl font-bold">Comment faire jouer la garantie ?</h2>
        <p class="mt-3 text-text-muted">Simple, rapide, sans paperasse.</p>
      </div>
      <div data-reveal-children class="grid md:grid-cols-4 gap-6 max-w-4xl mx-auto">
        {[
          { step: "1", title: "Contactez-nous", desc: "Par téléphone, e-mail, WhatsApp ou directement en boutique." },
          { step: "2", title: "Vérification", desc: "Nous vérifions votre facture et la date de réparation." },
          { step: "3", title: "Diagnostic", desc: "Le technicien identifie le problème et confirme la prise en charge." },
          { step: "4", title: "Réparation", desc: "La réparation est faite gratuitement, généralement dans la journée." },
        ].map((item) => (
          <div class="text-center">
            <div class="flex h-10 w-10 items-center justify-center rounded-full bg-primary text-white font-display font-bold text-sm mx-auto mb-4">{item.step}</div>
            <h3 class="font-display text-sm font-bold mb-1">{item.title}</h3>
            <p class="text-xs text-text-muted">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16 bg-bg-alt">
    <div class="mx-auto max-w-3xl px-6 lg:px-8">
      <h2 data-reveal class="font-display text-2xl font-bold text-center mb-10">Questions sur la garantie</h2>
      <div data-reveal class="space-y-4">
        {[
          { q: "Ma garantie est-elle transférable si je revends mon appareil ?", a: "Non, la garantie est liée au client qui a fait effectuer la réparation et n'est pas transférable." },
          { q: "Dois-je conserver ma facture ?", a: "Oui. Conservez votre facture ou confirmation de réparation. Nous gardons aussi un historique dans notre système, mais la facture facilite le traitement." },
          { q: "Puis-je faire jouer la garantie dans une autre boutique Fatfix ?", a: "Oui, la garantie est valable dans toutes nos boutiques (Bruxelles et Liège) et par envoi postal." },
          { q: "Le délai de la garantie repart-il après une réparation sous garantie ?", a: "Le délai initial ne change pas. Si votre garantie expire dans 2 mois et que nous intervenons, vous gardez les 2 mois restants." },
          { q: "Que se passe-t-il si la pièce n'est plus disponible ?", a: "Nous vous proposons une pièce équivalente ou supérieure, sans frais supplémentaires." },
        ].map((item) => (
          <details class="card group">
            <summary class="flex items-center justify-between gap-4 p-5 cursor-pointer">
              <span class="font-display font-semibold text-sm text-text">{item.q}</span>
              <svg class="h-5 w-5 text-primary flex-shrink-0 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
            </summary>
            <div class="px-5 pb-5 text-sm text-text-muted leading-relaxed">{item.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16">
    <div class="mx-auto max-w-3xl px-6 lg:px-8 text-center" data-reveal>
      <h2 class="font-display text-2xl sm:text-3xl font-bold">Un problème après réparation ?</h2>
      <p class="mt-4 text-text-muted">Contactez-nous immédiatement. On s'en occupe.</p>
      <div class="mt-6 flex flex-wrap justify-center gap-4">
        <a href="/contact" class="inline-flex items-center gap-2 rounded-full bg-primary hover:bg-primary-dark px-7 py-3.5 text-sm font-semibold text-white transition-colors shadow-md">Nous contacter</a>
        <a href="tel:+32400000001" class="inline-flex items-center gap-2 rounded-full border-2 border-primary text-primary hover:bg-primary hover:text-white px-7 py-3.5 text-sm font-semibold transition-all">Appeler</a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
